# Neon PostgreSQL (connection string from Neon dashboard; use pooled URL for Vercel)
# Quote the URL if it contains & (e.g. sslmode=require&channel_binding=require)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth (generate NEXTAUTH_SECRET with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL=http://localhost:3000

# Resend (https://resend.com) API key from Dashboard. For local testing, FROM_EMAIL can stay onboarding@resend.dev.
RESEND_API_KEY=your-resend-api-key-here
FROM_EMAIL="Ground Work <onboarding@resend.dev>"

# Public site URL for links in broadcast emails (no trailing slash). Use your production domain in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin credentials (used by NextAuth credentials provider)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-strong-admin-password
